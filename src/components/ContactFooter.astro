---
import profile from '../data/profile.en.json';
---

<style>
  /* Hazard stripe sweep on hover — DIRECT LINE CTA */
  .cta-hazard {
    position: relative;
    overflow: hidden;
  }
  .cta-hazard::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 215, 0, 0.16) 0,
      rgba(255, 215, 0, 0.16) 10px,
      transparent 10px,
      transparent 20px
    );
    transform: translateX(-101%);
    transition: transform 0.45s ease-out;
    pointer-events: none;
  }
  .cta-hazard:hover::after,
  .cta-hazard:focus-visible::after {
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-hazard::after {
      display: none;
    }
  }
</style>

<div
  class="w-full py-12 bg-miku-surface/30 dark:bg-miku-dark-surface/30 border-t border-miku-cyan/10 dark:border-miku-cyan/10"
>
  <div class="container mx-auto px-4 sm:px-8 lg:px-12">
    <!-- DIRECT LINE header -->
    <div class="flex items-center gap-3 sm:gap-4 mb-8">
      <span class="font-mono text-xs tracking-widest select-none text-miku-teal-strong dark:text-miku-glow">// DIRECT LINE</span>
      <h2 id="ct-title" data-i18n="contact.title" class="clip-chamfer-sm border border-miku-teal-strong/40 dark:border-miku-cyan/30 bg-miku-surface dark:bg-miku-dark-surface px-3 py-1.5 font-mono text-xs sm:text-sm font-bold uppercase tracking-widest whitespace-nowrap text-miku-text-main dark:text-miku-dark-text">
        {profile.contact.title}
      </h2>
      <div aria-hidden="true" class="flex-1 h-px bg-gradient-to-r from-miku-teal-strong/50 dark:from-miku-cyan/40 to-transparent"></div>
    </div>

    <div class="flex flex-col lg:flex-row justify-between items-center gap-8">
      <!-- Left: giant mono email (the direct line) -->
      <div class="text-center lg:text-left">
        <a
          href={`mailto:${profile.contact.email}`}
          class="cta-hazard clip-chamfer-sm inline-block px-5 py-3 border border-miku-teal-strong/40 dark:border-miku-cyan/30 hover:border-miku-teal-strong dark:hover:border-miku-glow transition-colors duration-300"
        >
          <span class="font-mono text-lg sm:text-2xl font-bold break-all text-miku-text-main dark:text-miku-dark-text">
            {profile.contact.email}
          </span>
        </a>
        <p id="ct-sub" data-i18n="contact.subtitle" class="mt-3 text-xs sm:text-sm text-miku-text-dim dark:text-miku-dark-dim">
          {profile.contact.subtitle}
        </p>
      </div>

      <!-- Right: social links (chamfered) -->
      <div class="flex gap-3 sm:gap-4">
        <a
          href={profile.contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group clip-chamfer-sm flex items-center gap-2 px-4 py-2.5 bg-miku-surface dark:bg-miku-dark-surface hover:bg-miku-cyan/10 dark:hover:bg-miku-cyan/20 transition-all duration-300 border border-miku-border-dim dark:border-miku-dark-border hover:border-miku-cyan/50"
          title="LinkedIn"
        >
          <svg
            fill="currentColor"
            class="w-5 h-5 text-miku-text-main dark:text-miku-dark-text group-hover:text-miku-teal-strong dark:group-hover:text-miku-cyan transition-colors"
            viewBox="0 0 24 24"
            ><path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.06 2.06 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065m1.782 13.019H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"
            ></path></svg
          >
          <span class="text-sm font-medium text-miku-text-dim dark:text-miku-dark-dim group-hover:text-miku-text-main dark:group-hover:text-miku-dark-text">LinkedIn</span>
        </a>

        <a
          href={profile.contact.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group clip-chamfer-sm flex items-center gap-2 px-4 py-2.5 bg-miku-surface dark:bg-miku-dark-surface hover:bg-miku-cyan/10 dark:hover:bg-miku-cyan/20 transition-all duration-300 border border-miku-border-dim dark:border-miku-dark-border hover:border-miku-cyan/50"
          title="GitHub"
        >
          <svg
            fill="currentColor"
            class="w-5 h-5 text-miku-text-main dark:text-miku-dark-text group-hover:text-miku-teal-strong dark:group-hover:text-miku-cyan transition-colors"
            viewBox="0 0 24 24"
            ><path
              d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12"
            ></path></svg
          >
          <span class="text-sm font-medium text-miku-text-dim dark:text-miku-dark-dim group-hover:text-miku-text-main dark:group-hover:text-miku-dark-text">GitHub</span>
        </a>
      </div>
    </div>

    <!-- Closing: angular mark + credit -->
    <div class="text-center mt-10 pt-6 border-t border-miku-cyan/10 dark:border-miku-cyan/10">
      <div aria-hidden="true" class="flex items-center justify-center gap-3 mb-4">
        <span class="h-px w-12 bg-gradient-to-r from-transparent to-miku-teal-strong/60 dark:to-miku-cyan/50"></span>
        <span class="w-2 h-2 rotate-45 border border-miku-teal-strong dark:border-miku-glow"></span>
        <span class="h-px w-12 bg-gradient-to-l from-transparent to-miku-teal-strong/60 dark:to-miku-cyan/50"></span>
      </div>
      <p data-i18n="contact.footer_credit" class="text-xs text-miku-text-dim dark:text-miku-dark-dim">
        © {new Date().getFullYear()} Willy Samuel Paz Colque. {profile.contact.footer_credit}
      </p>
    </div>
  </div>
</div>
