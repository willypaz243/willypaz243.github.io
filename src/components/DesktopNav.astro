---
import profile from '../data/profile.en.json';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import StatusBadge from './StatusBadge.astro';
---

<!-- Desktop Navigation Bar -->
<nav
  class="fixed top-0 left-0 right-0 z-50 bg-miku-surface/80 dark:bg-miku-dark-surface/80 backdrop-blur-md border-b border-miku-teal-strong/40 dark:border-miku-cyan/25 shadow-miku-light"
>
  <div class="container mx-auto px-4 sm:px-8 lg:px-12">
    <div class="flex justify-between items-center h-nav-h">
      <!-- Logo (accessible name = visible text; no conflicting aria-label) -->
      <a href="/" title="WillyDev - home">
        <span class="font-mono text-xl font-bold tracking-tighter text-miku-teal-strong dark:text-miku-cyan select-none">
          {profile.branding.logo}
        </span>
      </a>

      <!-- Navigation Links -->
      <div class="flex items-center gap-3">
        <div class="hidden md:flex gap-2 items-center">
          {
            profile.navigation.map(section => (
              <a
                href={`#${section.id}`}
                data-i18n-nav={section.id}
                data-nav-section={section.id}
                class:list={[
                  'nav-link text-sm font-medium transition-colors duration-300',
                  section.id === 'footer'
                    ? 'nav-control border-miku-cyan/50 dark:border-miku-glow/40 text-miku-teal-strong dark:text-miku-glow hover:bg-miku-cyan/10'
                    : 'px-2 py-2 text-miku-text-dim dark:text-miku-dark-dim hover:text-miku-cyan',
                ]}
              >
                <span>{section.label}</span>
              </a>
            ))
          }
        </div>
        <div class="flex items-center gap-2">
          <StatusBadge class="hidden xl:inline-flex" />
          <StatusBadge compact class="hidden md:inline-flex xl:hidden" />
          <LanguageToggle />
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</nav>
