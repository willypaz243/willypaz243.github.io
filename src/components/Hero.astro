---
import profile from '../data/profile.en.json';
---

<style>
  .cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: #39c5bb; /* miku.cyan */
    animation: blink 1s infinite;
    vertical-align: middle;
    margin-left: 2px;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Boot sequence — lines appear, then the block clears so only the
     Python code remains on screen ("how the code gets generated") */
  #boot-sequence {
    overflow: hidden;
    transition:
      opacity 0.3s ease,
      max-height 0.3s ease,
      margin-bottom 0.3s ease;
  }
  #boot-sequence:not(.boot-done) {
    max-height: 5rem;
  }

  .boot-line {
    opacity: 0;
    animation: boot-in 0.35s ease-out forwards;
  }
  .boot-d1 {
    animation-delay: 0.4s;
  }
  .boot-d2 {
    animation-delay: 1s;
  }
  .boot-d3 {
    animation-delay: 1.6s;
  }

  @keyframes boot-in {
    to {
      opacity: 1;
    }
  }

  .boot-done {
    opacity: 0;
    max-height: 0;
    margin-bottom: 0;
  }

  /* SYNC RATE gauge — fills from the left once on load */
  .sync-fill {
    transform-origin: left;
    animation: sync-fill 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.8s both;
  }

  @keyframes sync-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Final state = code only, no boot text */
    #boot-sequence {
      display: none;
    }
    .boot-line,
    .sync-fill {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<section class="min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 py-8 animate-fade-in">
  <div class="w-full max-w-7xl grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
    <!-- Left Column: Identity -->
    <div class="order-2 lg:order-1 flex flex-col justify-center text-left lg:text-left" style="gap: 0.75rem;">
      <!-- System line -->
      <p
        data-animate
        class="hidden md:flex items-center gap-2 font-mono text-xs tracking-widest select-none text-miku-teal-strong dark:text-miku-glow"
      >
        <span aria-hidden="true" class="w-1.5 h-1.5 bg-miku-glow animate-pulse"></span>
        WPC-04 // IDENTITY MODULE
      </p>

      <!-- Headline (hidden on mobile) -->
      <h1
        id="hero-title"
        data-animate
        data-i18n="personal.title"
        class="hidden md:block text-3xl sm:text-4xl lg:text-5xl font-bold text-miku-text-main dark:text-miku-dark-text"
      >
        {profile.personal.title}
      </h1>

      <!-- Value Proposition (hidden on mobile) -->
      <p
        data-animate
        data-i18n="personal.tagline"
        class="hidden md:block text-lg sm:text-xl text-miku-text-dim dark:text-miku-dark-dim leading-relaxed"
      >
        {profile.personal.tagline}
      </p>

      <!-- CTA Buttons (chamfered) -->
      <div data-animate-stagger class="flex gap-3 sm:gap-4">
        <a
          id="cta-projects"
          data-magnetic
          href="#projects"
          data-i18n="hero.cta_projects"
          class="clip-chamfer-sm inline-block px-6 py-2.5 bg-miku-cyan hover:bg-miku-glow text-miku-dark-base transition-all duration-300 transform hover:-translate-y-1 hover:shadow-glow-cyan"
        >
          {profile.hero.cta_projects}
        </a>
        <a
          id="cta-contact"
          data-magnetic
          href="#footer"
          data-i18n="hero.cta_contact"
          class="clip-chamfer-sm inline-block px-6 py-2.5 border border-miku-teal-strong/40 dark:border-miku-cyan/30 text-miku-text-dim dark:text-miku-dark-dim hover:text-miku-teal-strong hover:border-miku-teal-strong/70 dark:hover:text-miku-magenta dark:hover:border-miku-magenta/60 transition-all duration-300 transform hover:-translate-y-1"
        >
          {profile.hero.cta_contact}
        </a>
      </div>

      <!-- Availability -->
      <p data-i18n="personal.availability" class="text-sm text-green-700 dark:text-miku-success flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-miku-success animate-pulse"></span>
        {profile.personal.availability}
      </p>

      <!-- About Me -->
      <div data-animate class="mt-2">
        <h2
          id="about-title"
          data-i18n="about.title"
          class="font-mono text-sm font-bold uppercase tracking-widest mb-2 text-miku-text-main dark:text-miku-dark-text"
        >
          <span aria-hidden="true" class="text-miku-teal-strong dark:text-miku-glow">//</span> {profile.about.title}
        </h2>
        <p id="about-desc" data-i18n="about.description" class="text-sm text-miku-text-dim dark:text-miku-dark-dim leading-relaxed max-w-lg">
          {profile.about.description}
        </p>
      </div>
    </div>

    <!-- Right Column: NERV Terminal -->
    <div class="order-1 lg:order-2" data-animate>
      <div
        class="clip-chamfer relative border border-miku-teal-strong/50 dark:border-miku-cyan/30 bg-miku-base dark:bg-miku-dark-surface shadow-miku-light dark:shadow-glow-cyan"
      >
        <!-- HUD scanline overlay -->
        <div aria-hidden="true" class="scanlines absolute inset-0 pointer-events-none"></div>

        <!-- Terminal Header -->
        <div
          class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-miku-teal-strong/30 dark:border-miku-cyan/20"
        >
          <div class="flex items-center gap-2 font-mono text-xs tracking-widest">
            <span aria-hidden="true" class="w-2 h-2 rounded-full bg-miku-glow animate-pulse"></span>
            <span class="font-bold text-miku-text-main dark:text-miku-dark-text">WPC-04</span>
            <span class="hidden sm:inline text-miku-text-dim dark:text-miku-dark-dim">// SYSTEMS ONLINE</span>
          </div>
          <span aria-hidden="true" class="font-mono text-xs text-miku-text-dim dark:text-miku-dark-dim select-none">v2.0.4</span>
        </div>

        <!-- Terminal Content — the screen is always dark (instrument bezel pattern) -->
        <div class="bg-miku-dark-base p-4 sm:p-6 font-mono text-xs sm:text-sm md:text-base min-h-terminal lg:min-h-terminal-lg">
          <!-- Boot sequence -->
          <div id="boot-sequence" aria-hidden="true" class="space-y-1 mb-4">
            <p class="boot-line boot-d1">
              <span class="text-miku-glow">&gt; INITIALIZING WPC-04</span> <span class="text-miku-success">... OK</span>
            </p>
            <p class="boot-line boot-d2 text-miku-dark-dim">
              &gt; LOADING PROFILE MODULE <span class="text-miku-success">... OK</span>
            </p>
            <p class="boot-line boot-d3 text-miku-dark-dim">&gt; SYNC RATE: STABLE</p>
          </div>

          <code id="terminal-code" class="whitespace-pre-wrap break-words text-miku-dark-text"></code>
        </div>

        <!-- Sync Rate Gauge -->
        <div
          class="flex items-center gap-3 px-4 sm:px-5 py-3 border-t border-miku-teal-strong/30 dark:border-miku-cyan/20 font-mono text-xs"
        >
          <span class="text-miku-text-dim dark:text-miku-dark-dim tracking-widest whitespace-nowrap select-none">SYNC RATE</span>
          <div aria-hidden="true" class="flex-1 h-1.5 bg-miku-teal-strong/15 dark:bg-miku-cyan/10 overflow-hidden">
            <div class="sync-fill h-full w-full bg-gradient-to-r from-miku-cyan to-miku-glow"></div>
          </div>
          <span class="font-bold text-miku-teal-strong dark:text-miku-glow select-none">92%</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ profile }}>
  // Python code to type out
  const code = `from dataclasses import dataclass, field
from typing import List

@dataclass
class Developer:
    name: str = "${profile.personal.name}"
    role: str = "${profile.personal.title}"
    location: str = "${profile.personal.location}"
    experience_years: int = ${profile.about.experience}
    
    stack: List[str] = field(
        default_factory=lambda: [
            "Python", "FastAPI", "LangChain",
            "React", "Docker", "AWS"
        ]
    )
    focus: str = "RAG Systems • Scalable APIs • Cloud Infra"
    
    @property
    def available(self) -> bool:
        return True  # Open to remote work`;

  // Syntax highlighting colors (Miku palette)
  const colors = {
    keyword: '#FF0080', // MAGENTA_POP for keywords
    string: '#00E676', // FUNC_SUCCESS for strings
    number: '#48FFF4', // MIKU_GLOW for numbers
    comment: '#8B949E', // TXT_DIM for comments
    class_name: '#39C5BB', // MIKU_CYAN for class names
    function: '#7B61FF', // TECH_VIOLET for functions
    default: '#F0F6FC', // TXT_MAIN for default
  };

  // Tokenize and highlight code
  function highlightCode(code) {
    // Escape HTML first
    let result = code.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    // Token types with their patterns
    const tokens = [
      { type: 'string', pattern: /(".*?"|'.*?')/g },
      {
        type: 'keyword',
        pattern:
          /\b(from|import|class|def|str|int|list|return|if|else|for|while|True|False|None|@property|dataclass|field)\b/g,
      },
      { type: 'class_name', pattern: /\b([A-Z][a-zA-Z0-9_]*)\b/g },
      { type: 'number', pattern: /\b(\d+)\b/g },
    ];

    // Track which positions are already highlighted
    const highlighted = new Set();
    const parts = [];

    // Find all token matches
    const matches = [];
    tokens.forEach(token => {
      let match;
      const regex = new RegExp(token.pattern.source, token.pattern.flags);
      while ((match = regex.exec(result)) !== null) {
        matches.push({
          type: token.type,
          start: match.index,
          end: match.index + match[0].length,
          text: match[0],
        });
      }
    });

    // Sort matches by start position
    matches.sort((a, b) => a.start - b.start);

    // Build highlighted string
    let lastEnd = 0;
    matches.forEach(match => {
      // Check if this match overlaps with already highlighted content
      let overlaps = false;
      for (let i = match.start; i < match.end; i++) {
        if (highlighted.has(i)) {
          overlaps = true;
          break;
        }
      }

      if (!overlaps) {
        // Add non-highlighted text before this match
        if (match.start > lastEnd) {
          parts.push(result.substring(lastEnd, match.start));
        }

        // Add highlighted text
        const color = colors[match.type] || colors.default;
        parts.push(`<span style="color: ${color}">${match.text}</span>`);

        // Mark positions as highlighted
        for (let i = match.start; i < match.end; i++) {
          highlighted.add(i);
        }

        lastEnd = match.end;
      }
    });

    // Add remaining non-highlighted text
    if (lastEnd < result.length) {
      parts.push(result.substring(lastEnd));
    }

    return parts.join('');
  }

  // Typing animation
  async function typeCode() {
    const terminal = document.getElementById('terminal-code');
    if (!terminal) return;

    const typingSpeed = 5; // ms per character

    for (let i = 1; i <= code.length; i++) {
      const partialCode = code.substring(0, i);
      const highlighted = highlightCode(partialCode);

      // Add cursor
      terminal.innerHTML = highlighted + '<span class="cursor"></span>';

      await new Promise(resolve => setTimeout(resolve, typingSpeed));
    }

    // Remove cursor after typing completes
    setTimeout(() => {
      const cursor = terminal.querySelector('.cursor');
      if (cursor) cursor.remove();
    }, 2000);
  }

  // Start: boot lines fade in, then the block clears and the code types out,
  // so the finished screen shows Python only. With reduced motion, render
  // the final code immediately (boot block is hidden via CSS).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion) {
    const terminal = document.getElementById('terminal-code');
    if (terminal) terminal.innerHTML = highlightCode(code);
  } else {
    setTimeout(() => {
      const boot = document.getElementById('boot-sequence');
      if (boot) boot.classList.add('boot-done');
      setTimeout(typeCode, 350);
    }, 2100);
  }
</script>
