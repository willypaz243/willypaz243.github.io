---
// LanguageToggle — client-side component for ES/EN switching
---

<!-- Language Toggle Button -->
<button
  id="language-toggle"
  class="nav-control chamfer-rim rim-nav fill-surface-80 fill-hover-cyan-10"
>
  <span class="sr-only" data-i18n="labels.switch_language">Switch language:</span>
  <span id="lang-label">ES</span>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById('language-toggle');
    const label = document.getElementById('lang-label');
    if (!btn || !label) return;

    function updateLabel() {
      const lang = localStorage.getItem('lang') || 'en';
      label.textContent = lang === 'en' ? 'ES' : 'EN';
    }

    btn.addEventListener('click', () => {
      const current = localStorage.getItem('lang') || 'en';
      const next = current === 'en' ? 'es' : 'en';
      if (typeof window.switchLanguage === 'function') window.switchLanguage(next);
      updateLabel();
    });

    updateLabel();
  })();
</script>
