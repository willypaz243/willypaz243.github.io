---
import profile from '../data/profile.en.json';

// Minimal NERV-style stroke glyphs (replace emoji) — one per nav section id
const GLYPHS: Record<string, string> = {
  about: '<circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path>',
  experience: '<rect x="4" y="8" width="16" height="11"></rect><path d="M9 8V6h6v2M4 13h16"></path>',
  projects: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"></path>',
  skills: '<rect x="7" y="7" width="10" height="10"></rect><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"></path>',
  footer: '<rect x="3" y="5" width="18" height="14"></rect><path d="m3 7 9 6 9-6"></path>',
};
const navIds: string[] = profile.navigation.map(section => section.id);
---

<style is:global>
  /* Scrollspy active state — shared by desktop links (.nav-link) and mobile glyph bar */
  a.nav-active {
    color: var(--miku-teal-strong);
  }
  .dark a.nav-active {
    color: var(--miku-glow);
  }
  .dark a.nav-active svg {
    filter: drop-shadow(0 0 5px rgba(72, 255, 244, 0.55));
  }
  /* Desktop: underline indicator under the active section link */
  a.nav-link {
    position: relative;
  }
  a.nav-link.nav-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: currentColor;
  }
  /* The CTA is chamfered: an underline outside its box is clipped away, so mark it from inside */
  a.nav-cta.nav-active::after {
    content: none;
  }
  a.nav-cta.nav-active {
    background-color: rgba(57, 197, 187, 0.14);
    box-shadow: inset 0 -2px 0 currentColor;
  }
  /* One focus ring for every nav control, in the brand color */
  nav a:focus-visible,
  nav button:focus-visible {
    outline: 2px solid var(--miku-focus);
    outline-offset: 2px;
  }
</style>

<!-- Mobile Navigation Bar -->
<nav class="fixed bottom-nav-bar-inset left-1/2 -translate-x-1/2 z-50 md:hidden">
    <ul aria-label="Sections" data-i18n-aria="labels.nav_sections" class="flex items-center gap-1 p-1.5 clip-chamfer-sm border border-miku-teal-strong/40 dark:border-miku-cyan/25 bg-miku-surface/80 dark:bg-miku-dark-surface/80 backdrop-blur-md shadow-miku-light">
      {
        profile.navigation.map(section => (
          <li>
            <a
              href={`#${section.id}`}
              data-i18n-nav={section.id}
              data-nav-section={section.id}
              aria-label={section.label}
              class="w-11 h-11 flex items-center justify-center text-miku-text-main dark:text-miku-dark-text transition-colors hover:text-miku-teal-strong dark:hover:text-miku-glow group relative"
            >
              <svg aria-hidden="true" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <Fragment set:html={GLYPHS[section.id] || ''} />
              </svg>

              <!-- Tooltip (visible on hover); the accessible name comes from aria-label -->
              <span aria-hidden="true" class="absolute -top-12 left-1/2 -translate-x-1/2 px-2 py-1 text-xs text-miku-text-main dark:text-miku-dark-text bg-miku-surface/90 dark:bg-miku-dark-surface/90 backdrop-blur-sm border border-miku-teal-strong/40 dark:border-miku-cyan/25 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
                {section.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

<script is:inline define:vars={{ navIds }}>
  // Scrollspy: highlights the active section in the desktop links and the mobile glyph bar
  (() => {
    const links = document.querySelectorAll('[data-nav-section]');
    if (!links.length) return;

    const sections = navIds.map(id => document.getElementById(id)).filter(Boolean);
    if (!sections.length) return;

    const setActive = (id) => {
      links.forEach(l => l.classList.toggle('nav-active', l.getAttribute('data-nav-section') === id));
    };

    const io = new IntersectionObserver(
      entries => {
        entries.forEach(e => {
          if (e.isIntersecting) setActive(e.target.id);
        });
      },
      { rootMargin: '0px 0px -70% 0px' }
    );

    sections.forEach(s => io.observe(s));

    // The last section can never reach the top band at the end of the page, and the
    // first one is skipped when the hero starts above it: settle both edges explicitly.
    const onScroll = () => {
      const doc = document.documentElement;
      if (window.innerHeight + window.scrollY >= doc.scrollHeight - 24) setActive(navIds[navIds.length - 1]);
      else if (window.scrollY <= 8) setActive(navIds[0]);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
