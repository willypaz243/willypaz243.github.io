---
import profile from '../data/profile.en.json';

// Minimal NERV-style stroke glyphs (replace emoji) — one per nav section id
const GLYPHS: Record<string, string> = {
  about: '<circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path>',
  experience: '<rect x="4" y="8" width="16" height="11"></rect><path d="M9 8V6h6v2M4 13h16"></path>',
  projects: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"></path>',
  skills: '<rect x="7" y="7" width="10" height="10"></rect><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"></path>',
  footer: '<rect x="3" y="5" width="18" height="14"></rect><path d="m3 7 9 6 9-6"></path>',
};
---

<style>
  a.nav-active {
    color: #00a396; /* miku.teal-strong */
  }
  .dark a.nav-active {
    color: #48fff4; /* miku.glow */
  }
  .dark a.nav-active svg {
    filter: drop-shadow(0 0 5px rgba(72, 255, 244, 0.55));
  }
</style>

<!-- Mobile Navigation Bar -->
<nav class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 md:hidden">
    <ul class="flex items-center gap-1 p-1.5 clip-chamfer-sm border border-miku-teal-strong/40 dark:border-miku-cyan/25 bg-miku-surface dark:bg-miku-dark-surface shadow-miku-light">
      {
        profile.navigation.map(section => (
          <li>
            <a
              href={`#${section.id}`}
              data-i18n-nav={section.id}
              data-nav-section={section.id}
              class="w-10 h-10 flex items-center justify-center text-miku-text-main dark:text-miku-dark-text transition-colors hover:text-miku-teal-strong dark:hover:text-miku-glow group relative"
              title={section.label}
            >
              <svg aria-hidden="true" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <Fragment set:html={GLYPHS[section.id] || ''} />
              </svg>

              <!-- Tooltip (visible on hover) -->
              <span class="absolute -top-12 left-1/2 -translate-x-1/2 px-2 py-1 text-xs text-miku-text-main dark:text-miku-dark-text bg-miku-surface dark:bg-miku-dark-surface border border-miku-cyan dark:border-miku-cyan opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
                {section.label}
              </span>
            </a>
          </li>
        ))
      }
      <li>
        <div class="flex items-center gap-1 px-2 py-1.5 border border-miku-success/30 bg-miku-success/10">
          <span class="w-1.5 h-1.5 rounded-full bg-miku-success animate-pulse"></span>
        </div>
      </li>
    </ul>
  </nav>

<script is:inline>
  // Scrollspy: highlight the active section in the mobile nav
  (() => {
    const links = document.querySelectorAll('[data-nav-section]');
    if (!links.length) return;

    const ids = ['about', 'projects', 'experience', 'skills', 'footer'];
    const sections = ids.map(id => document.getElementById(id)).filter(Boolean);
    if (!sections.length) return;

    const setActive = (id) => {
      links.forEach(l => l.classList.toggle('nav-active', l.getAttribute('data-nav-section') === id));
    };

    const io = new IntersectionObserver(
      entries => {
        entries.forEach(e => {
          if (e.isIntersecting) setActive(e.target.id);
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );

    sections.forEach(s => io.observe(s));
  })();
</script>
