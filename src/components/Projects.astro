---
import profile from '../data/profile.en.json';
import SectionHeading from './SectionHeading.astro';

// Determine if a link is a live demo (not GitHub)
function isLiveDemo(link: string): boolean {
  return link !== '#' && !link.includes('github.com');
}

type MetricRow = { key: string; value: string; i18n: string };

type ProjectCard = {
  project: (typeof profile.projects)[number];
  origIndex: number;
  unit: string;
  titleI18n: string;
  descI18n: string;
  metrics: MetricRow[];
};

// Pre-compute card data (keeps inline JSX expressions shallow)
const cards: ProjectCard[] = profile.projects
  .map((project, idx) => ({ project, idx }))
  .filter(({ project }) => project.link !== '#')
  .map(({ project, idx }) => {
    const rawMetrics = Object.entries(
      ((project as { metrics?: unknown }).metrics || {}) as Record<string, string>
    );
    return {
      project,
      origIndex: idx,
      unit: String(idx + 1).padStart(2, '0'),
      titleI18n: `projects.${idx}.title`,
      descI18n: `projects.${idx}.description`,
      metrics: rawMetrics.map(([key, value]) => ({
        key,
        value,
        i18n: `projects.${idx}.metrics.${key}`,
      })),
    };
  });
---

<section class="mb-16">
  <SectionHeading
    num="01"
    title={profile.sections.projects}
    i18n="sections.projects"
    tag="DOSSIERS"
    id="proj-title"
  />
  <div data-animate-stagger class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
    {
      cards.map(card => (
        <article
          data-animate
          class="group clip-chamfer-sm relative border border-miku-border-dim dark:border-miku-dark-border bg-miku-surface dark:bg-miku-dark-surface transition-all duration-300 hover:-translate-y-1 hover:border-miku-teal-strong/60 dark:hover:border-miku-cyan/50 hover:shadow-glow-cyan"
        >
          {/* HUD grid backdrop */}
          <div aria-hidden="true" class="hud-grid absolute inset-0 pointer-events-none"></div>

          <div class="relative p-5 sm:p-6">
            {/* Dossier header: unit tag + status LED */}
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs tracking-widest select-none text-miku-teal-strong dark:text-miku-dark-dim">
                UNIT-{card.unit}
              </span>
              <span
                aria-hidden="true"
                class="w-2 h-2 rounded-full bg-miku-glow animate-pulse transition-colors duration-300 group-hover:bg-miku-magenta"
              ></span>
            </div>

            {/* Project Title */}
            <h3 data-i18n={card.titleI18n} class="text-xl sm:text-2xl font-semibold mb-2 text-miku-text-main dark:text-miku-dark-text">
              {card.project.title}
            </h3>

            {/* Description */}
            <p data-i18n={card.descI18n} class="text-sm leading-relaxed mb-4 text-miku-text-dim dark:text-miku-dark-dim">
              {card.project.description}
            </p>

            {/* Spec table — projects[].metrics (previously unused) */}
            {card.metrics.length > 0 && (
              <dl class="mb-5 border-l-2 border-miku-teal-strong/40 dark:border-miku-cyan/30 pl-3 space-y-1.5">
                {card.metrics.map(row => (
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-0.5 sm:gap-4">
                    <dt class="font-mono text-xs uppercase tracking-wider shrink-0 text-miku-teal-strong dark:text-miku-dark-dim">{row.key}</dt>
                    <dd data-i18n={row.i18n} class="text-xs sm:text-sm text-miku-text-main dark:text-miku-dark-text sm:text-right">
                      {row.value}
                    </dd>
                  </div>
                ))}
              </dl>
            )}

            {/* Tech Stack Badges (chamfered chips) */}
            <div class="flex flex-wrap gap-1.5 mb-5">
              {card.project.technologies.map(tech => (
                <span class="clip-chamfer-sm px-2.5 py-1 text-xs font-mono bg-miku-base dark:bg-miku-dark-base border border-miku-border-dim dark:border-miku-dark-border text-miku-text-dim dark:text-miku-dark-dim group-hover:border-miku-cyan/40 transition-colors duration-300">
                  {tech}
                </span>
              ))}
            </div>

            {/* CTA Button */}
            {isLiveDemo(card.project.link) ? (
              /* Live Demo — primary style */
              <a
                href={card.project.link}
                class="clip-chamfer-sm inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium bg-miku-cyan/10 dark:bg-miku-cyan/15 border border-miku-cyan/30 text-miku-teal-strong dark:text-miku-cyan hover:bg-miku-cyan/20 transition-all duration-300"
                target="_blank"
                rel="noopener noreferrer"
                data-i18n="labels.view_project"
              >
                {profile.labels.view_project}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            ) : (
              /* Source Code — secondary style */
              <a
                href={card.project.link}
                class="clip-chamfer-sm inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium bg-miku-base dark:bg-miku-dark-base border border-miku-border-dim dark:border-miku-dark-border text-miku-text-main dark:text-miku-dark-text hover:border-miku-cyan/50 transition-all duration-300"
                target="_blank"
                rel="noopener noreferrer"
                data-i18n="labels.source_code"
              >
                {profile.labels.source_code}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
