---
import profile from '../data/profile.en.json';
import SectionHeading from './SectionHeading.astro';
---

<section id="skills" class="max-w-4xl mx-auto py-8 pb-32 md:pb-16 animate-fade-in">
  <SectionHeading
    num="03"
    title={profile.sections.skills_title}
    i18n="sections.skills_title"
    tag="SYSTEM MODULES"
    id="sk-title"
  />

  <div class="space-y-8 mt-4">
    {
      Object.entries(profile.skills)
        .filter(([, v]) => v && typeof v === 'object' && !Array.isArray(v))
        .map(([category, skills]: [string, any], idx) => {
          if (typeof skills !== 'object') return null;

        const categoryTitle = skills.title || '';
        const categoryExpertise = skills.expertise || '';
        const expertTools: string[] = skills.proficient_tools || [];
        const workingTools: string[] = skills.familiar_tools || [];
        const mod = String(idx + 1).padStart(2, '0');

        return (
          <div data-animate class="skill-module clip-chamfer relative border border-miku-border-dim dark:border-miku-dark-border bg-miku-surface/60 dark:bg-miku-dark-surface/40">
            {/* HUD grid backdrop */}
            <div aria-hidden="true" class="hud-grid absolute inset-0 pointer-events-none"></div>

            <div class="relative p-5 sm:p-6">
              {/* Module header */}
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
                <span class="font-mono text-xs tracking-widest select-none text-miku-teal-strong dark:text-miku-glow">MOD-{mod}</span>
                <h3 id={`sk-${category}_title`} class="text-lg sm:text-xl font-semibold text-miku-text-main dark:text-miku-dark-text">
                  <span data-i18n={`skills.${category}.title`}>{categoryTitle}</span>
                </h3>
              </div>

              {categoryExpertise && (
                <p class="font-mono text-xs mb-4 text-miku-text-dim dark:text-miku-dark-dim">
                  // <span data-i18n={`skills.${category}.expertise`}>{categoryExpertise}</span>
                </p>
              )}

              {/* Proficient tools */}
              <div class="mb-5">
                <p data-i18n="sections.daily" class="text-sm mb-2 font-medium text-miku-text-dim dark:text-miku-dark-dim">
                  {profile.sections.daily}
                </p>
                <div class="flex flex-wrap gap-2">
                  {expertTools.map((tool: string) => (
                    <span class="clip-chamfer-sm px-3 py-1.5 text-xs sm:text-sm font-mono bg-miku-cyan/10 dark:bg-miku-cyan/15 text-miku-teal-strong dark:text-miku-glow border border-miku-teal-strong/40 dark:border-miku-cyan/25 hover:border-miku-cyan transition-all">
                      {tool}
                    </span>
                  ))}
                </div>
              </div>

              {/* Familiar tools */}
              {workingTools.length > 0 && (
                <div>
                  <p data-i18n="sections.familiar" class="text-sm mb-2 font-medium text-miku-text-dim dark:text-miku-dark-dim">
                    {profile.sections.familiar}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {workingTools.map((tool: string) => (
                      <span class="clip-chamfer-sm px-3 py-1.5 text-xs sm:text-sm font-mono bg-miku-base dark:bg-miku-dark-base text-miku-text-dim dark:text-miku-dark-dim border border-miku-border-dim dark:border-miku-dark-border hover:border-miku-cyan/50 transition-all">
                        {tool}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        );
      })
    }

    {/* Soft skills — NEURAL LINK */}
    <div data-animate class="clip-chamfer relative border border-miku-border-dim dark:border-miku-dark-border bg-miku-surface/60 dark:bg-miku-dark-surface/40">
      <div aria-hidden="true" class="hud-grid absolute inset-0 pointer-events-none"></div>

      <div class="relative p-5 sm:p-6">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-5">
          <span class="font-mono text-xs tracking-widest select-none text-miku-teal-strong dark:text-miku-glow">NEURAL</span>
          <h3 id="sf-title" data-i18n="sections.soft_skills" class="text-lg sm:text-xl font-semibold text-miku-text-main dark:text-miku-dark-text">
            {profile.sections.soft_skills}
          </h3>
        </div>

        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
          {profile.skills.soft_skills.map((skill, j) => (
            <li class="flex items-center gap-3 text-sm text-miku-text-main dark:text-miku-dark-text">
              <svg aria-hidden="true" class="w-3.5 h-3.5 flex-shrink-0 text-miku-teal-strong dark:text-miku-glow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="6" cy="6" r="2.5"></circle>
                <path d="M6 0v3M6 9v3M0 6h3M9 6h3"></path>
              </svg>
              <span data-i18n={`skills.soft_skills.${j}`}>{skill}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
