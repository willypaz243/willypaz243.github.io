---
import profile from '../data/profile.en.json';

interface Props {
  /** Dot only (label kept for screen readers) — used between md and xl */
  compact?: boolean;
  /** Extra utilities, e.g. breakpoint visibility */
  class?: string;
}

const { compact = false, class: className = '' } = Astro.props;
---

<!-- Status state, not a control: pulsing dot + short label, no box (desktop nav; mobile uses the dot in the bottom bar) -->
<span
  role="status"
  aria-label={profile.personal.badge}
  data-i18n-aria="personal.badge"
  class:list={[
    'inline-flex items-center gap-2 px-1 text-sm font-medium leading-none text-miku-teal-strong dark:text-miku-success',
    compact && 'justify-center px-0 min-w-nav-ctl min-h-nav-ctl',
    className,
  ]}
>
  <span
    aria-hidden="true"
    class="w-2 h-2 shrink-0 rounded-full bg-miku-teal-strong dark:bg-miku-success animate-pulse motion-reduce:animate-none"
  ></span>
  <span data-i18n="personal.badge" class:list={[compact && 'sr-only']}>
    {profile.personal.badge}
  </span>
</span>
