<script>
  const themeToggle = document.getElementById('theme-toggle');
  const html = document.documentElement;
  const themeColorMeta = document.getElementById('theme-color-meta');

  // Check for saved theme preference, otherwise use system preference
  const theme =
    localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  html.classList.toggle('dark', theme === 'dark');

  function syncThemeColor() {
    if (themeColorMeta) {
      themeColorMeta.setAttribute(
        'content',
        html.classList.contains('dark') ? '#0F1419' : '#FAFCFF'
      );
    }
  }

  syncThemeColor();

  themeToggle?.addEventListener('click', () => {
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    syncThemeColor();
  });
</script>

<button
  id="theme-toggle"
  class="nav-control px-0"
  aria-label="Toggle theme"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="w-6 h-6 hidden dark:block text-miku-cyan glow-cyan"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
      class="glow-cyan-strong"></path>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="w-6 h-6 block dark:hidden text-miku-teal-strong glow-teal"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path>
  </svg>
</button>

