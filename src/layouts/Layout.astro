---
import DesktopNav from '../components/DesktopNav.astro';
import Navigation from '../components/Navigation.astro';
import en from '../data/profile.en.json';
import es from '../data/profile.es.json';
---

<!doctype html>
<html lang={en.lang || 'en'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Willy Samuel Paz Colque - {en.personal.title}</title>
    <meta name="description" content={en.meta.description} />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://willypaz.dev/" />

    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://willypaz.dev/" />
    <meta property="og:title" content={"Willy Samuel Paz Colque - " + en.personal.title} />
    <meta property="og:description" content={en.meta.description} />
    <meta property="og:image" content="https://willypaz.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://willypaz.dev/" />
    <meta name="twitter:title" content={"Willy Samuel Paz Colque - " + en.personal.title} />
    <meta name="twitter:description" content={en.meta.description} />
    <meta name="twitter:image" content="https://willypaz.dev/og-image.png" />

    <!-- Theme color — follows the manual toggle (updated by ThemeToggle script) -->
    <meta name="theme-color" id="theme-color-meta" content="#0F1419" />
    <script is:inline>
      // Set the correct theme-color before first paint (same logic as ThemeToggle)
      (() => {
        const saved = localStorage.getItem('theme');
        const dark = saved
          ? saved === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.getElementById('theme-color-meta')?.setAttribute('content', dark ? '#0F1419' : '#FAFCFF');
      })();
    </script>

    <!-- Google Fonts: Inter (body) + JetBrains Mono (code/terminal) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="font-sans bg-miku-base dark:bg-miku-dark-base text-miku-text-main dark:text-miku-dark-text transition-colors duration-300 pt-nav-offset"
  >
    <!-- Skip link: first focusable element (WCAG 2.4.1 Bypass Blocks). Hidden until focused. -->
    <a href="#main" class="skip-link" data-i18n="labels.skip_to_content">Skip to content</a>

    <script is:inline define:vars={{ en, es }}>
      (function () {
        var PROFILES = { en: en, es: es };

        function getNested(obj, path) {
          return path.split('.').reduce(function (acc, key) {
            if (acc && typeof acc === 'object' && key in acc) return acc[key];
            return undefined;
          }, obj);
        }

        function switchLang(lang) {
          var profile = PROFILES[lang];
          if (!profile) return;

          document.documentElement.lang = lang;
          localStorage.setItem('lang', lang);

          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var path = el.getAttribute('data-i18n');
            var value = getNested(profile, path);
            if (value !== undefined && value !== null) {
              if (typeof value === 'string') {
                el.textContent = value;
              }
            }
          });

          document.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
            var value = getNested(profile, el.getAttribute('data-i18n-aria'));
            if (typeof value === 'string') el.setAttribute('aria-label', value);
          });

          document.querySelectorAll('[data-i18n-nav]').forEach(function (el) {
            var navId = el.getAttribute('data-i18n-nav');
            var nav = (profile.navigation || []).find(function (n) { return n.id === navId; });
            if (nav) {
              el.setAttribute('aria-label', nav.label);
              el.removeAttribute('title');
              var tooltip = el.querySelector('span');
              if (tooltip) tooltip.textContent = nav.label;
            }
          });

          var lbl = document.getElementById('lang-label');
          if (lbl) lbl.textContent = lang === 'en' ? 'ES' : 'EN';
        }

        window.switchLanguage = switchLang;
        window.__PROFILES = PROFILES;

        document.addEventListener('DOMContentLoaded', function () {
          var saved = localStorage.getItem('lang');
          if (saved && saved !== 'en') switchLang(saved);
        });
      })();
    </script>
    <div class="relative">
      <DesktopNav />
      <slot />
      <Navigation />
    </div>

    <script is:inline src="/scroll-animations.js" defer></script>
  </body>
</html>

<style>
  /* Rim/fill channels of the chamfer system (see tailwind.config.mjs .chamfer-rim).
     Registered so hover color changes animate; unregistered browsers snap instantly. */
  @property --rim {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --fill {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  html {
    font-family: 'Inter', system-ui, sans-serif;
    /* Same clearance as the scroll-mt-nav utility (nav height incl. its 1px border) */
    scroll-padding-top: 71px;
    /* Single source for colors referenced from plain CSS (nav styles, focus ring, rim utilities) */
    --miku-teal-strong: #007a70;
    --miku-glow: #48fff4;
    --miku-focus: #39c5bb;
    /* Tokens used from plain CSS by the rim/fill utilities below */
    --miku-cyan: #39c5bb;
    --miku-magenta: #ff0080;
    --miku-base: #fafcff;
    --miku-surface: #e8f1f5;
    --miku-border-dim: #b0bec5;
    --miku-dark-base: #0f1419;
    --miku-dark-surface: #161b22;
    --miku-dark-border: #21262d;
    /* Chamfer rim colors (the 1px ring) by context; .dark overrides.
       Values mirror the border tokens each site had before the rim system. */
    --rim-nav: color-mix(in srgb, var(--miku-teal-strong) 40%, transparent);
    --rim-plate: color-mix(in srgb, var(--miku-teal-strong) 40%, transparent);
    --rim-card: var(--miku-border-dim);
    --rim-cyan: color-mix(in srgb, var(--miku-cyan) 30%, transparent);
    --rim-cta: color-mix(in srgb, var(--miku-cyan) 50%, transparent);
    --rim-hero: color-mix(in srgb, var(--miku-teal-strong) 50%, transparent);
    /* Chamfer fills (painted by the ::before inside the ring); mirror the bg-* tokens */
    --fill-surface-80: color-mix(in srgb, var(--miku-surface) 80%, transparent);
    --fill-surface-60-40: color-mix(in srgb, var(--miku-surface) 60%, transparent);
    --fill-surface-solid: var(--miku-surface);
    --fill-base: var(--miku-base);
    --fill-base-surface: var(--miku-base);
    --fill-cyan-10-15: color-mix(in srgb, var(--miku-cyan) 10%, transparent);
  }
  .dark {
    --rim-nav: color-mix(in srgb, var(--miku-cyan) 25%, transparent);
    --rim-plate: color-mix(in srgb, var(--miku-cyan) 30%, transparent);
    --rim-card: var(--miku-dark-border);
    --rim-cta: color-mix(in srgb, var(--miku-glow) 40%, transparent);
    --rim-hero: color-mix(in srgb, var(--miku-cyan) 30%, transparent);
    --fill-surface-80: color-mix(in srgb, var(--miku-dark-surface) 80%, transparent);
    --fill-surface-60-40: color-mix(in srgb, var(--miku-dark-surface) 40%, transparent);
    --fill-surface-solid: var(--miku-dark-surface);
    --fill-base: var(--miku-dark-base);
    --fill-base-surface: var(--miku-dark-surface);
    --fill-cyan-10-15: color-mix(in srgb, var(--miku-cyan) 15%, transparent);
  }
  body {
    margin: 0;
    min-height: 100vh;
    font-family: 'Inter', system-ui, sans-serif;
  }
  code,
  pre {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Skip link — off-screen until keyboard focus, then slides in */
  .skip-link {
    position: fixed;
    top: -100px;
    left: 16px;
    z-index: 100;
    padding: 10px 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #48fff4;
    background: #0f1419;
    border: 1px solid rgba(72, 255, 244, 0.5);
    clip-path: polygon(
      8px 0,
      100% 0,
      100% calc(100% - 8px),
      calc(100% - 8px) 100%,
      0 100%,
      0 8px
    );
    box-shadow:
      inset 0 0 12px rgba(72, 255, 244, 0.3),
      0 4px 20px rgba(0, 0, 0, 0.4);
    transition: top 0.18s ease-out;
  }
  .skip-link:focus {
    top: 16px;
    outline: none;
  }
</style>
