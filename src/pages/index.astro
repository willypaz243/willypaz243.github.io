---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import ContactFooter from '../components/ContactFooter.astro';
---

<Layout>
  <!-- Hero: full-width, outside main content constraints -->
  <div id="about" class="scroll-mt-16 animate-fade-in">
    <Hero />
  </div>
  <main class="max-w-4xl mx-auto px-4 py-12 space-y-24">
    <div id="experience" class="scroll-mt-16 animate-fade-in">
      <Experience />
    </div>
    <div id="projects" class="scroll-mt-16 animate-fade-in">
      <Projects />
    </div>
    <div id="skills" class="scroll-mt-16 animate-fade-in">
      <Skills />
    </div>
    <div id="footer" class="scroll-mt-16 animate-fade-in">
      <ContactFooter />
    </div>
  </main>
</Layout>
